# === ANCLORA NEXUS CONFIGURATION EXAMPLE ===

# --- SUPABASE: LOCAL DEVELOPMENT ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
PUBLIC_CTA_ORG_ID=00000000-0000-0000-0000-000000000000

# --- SUPABASE: CLOUD PRODUCTION ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-cloud-anon-key
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-cloud-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-cloud-service-role-key
# PUBLIC_CTA_ORG_ID=00000000-0000-0000-0000-000000000000

# --- AI RUNTIME PROFILE ---
AI_RUNTIME_PROFILE=groq-cloudflare

# Groq chat runtime
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRIMARY=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_NO_EVIDENCE=llama-3.1-8b-instant
GROQ_MODEL_GUARD=llama-3.1-8b-instant

# Cloudflare copy/edge runtime
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=
CLOUDFLARE_MODEL_PRIMARY=@cf/openai/gpt-oss-20b
CLOUDFLARE_MODEL_FALLBACK=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_FAST=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_NO_EVIDENCE=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_GUARD=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-small-en-v1.5

# Internal audit integrity secret
INTERNAL_AUDIT_SECRET=replace-with-random-secret

# --- VERCEL CRON ---
# Random secret string — set the same value in Vercel Dashboard > Settings > Environment Variables
CRON_SECRET=your-random-cron-secret

# --- FIRECRAWL SCRAPING ENGINE ---
# Used for automated FSBO detection from Idealista, Fotocasa, etc.
# Get your key at: https://firecrawl.dev
FIRECRAWL_API_KEY=your-firecrawl-api-key

# --- NOTEBOOKLM TERRITORIAL BRAIN ---
# Use your active NotebookLM notebook (e.g. "Inteligencia Territorial Suroeste Mallorca 2026")
NOTEBOOKLM_NOTEBOOK_ID=9f003773-16c5-4fb4-ab37-7b6c230ab4da
NOTEBOOKLM_NOTEBOOK_NAME=Inteligencia Territorial Suroeste Mallorca 2026
