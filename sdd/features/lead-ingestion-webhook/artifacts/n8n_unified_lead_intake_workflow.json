{
  "name": "Unified Lead Intake - Anclora Nexus",
  "nodes": [
    {
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 280],
      "parameters": {
        "path": "unified-lead-intake",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "name": "Parse & Normalize",
      "type": "n8n-nodes-base.code",
      "position": [520, 280],
      "parameters": {
        "jsCode": "const input = $json; return [{ json: { ...input, source_system: input.source_system || 'cta_web', source_channel: input.source_channel || 'website', source_detail: input.source_detail || 'private_estates_contact_form' } }];"
      }
    },
    {
      "name": "Save to Nexus",
      "type": "n8n-nodes-base.httpRequest",
      "position": [820, 280],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXUS_API_BASE_URL }}/api/ingestion/leads",
        "authentication": "predefinedCredentialType",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    },
    {
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1120, 280],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Parse & Normalize", "type": "main", "index": 0 }]]
    },
    "Parse & Normalize": {
      "main": [[{ "node": "Save to Nexus", "type": "main", "index": 0 }]]
    },
    "Save to Nexus": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  }
}
